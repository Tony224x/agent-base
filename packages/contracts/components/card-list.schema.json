{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["type", "cards"],
  "properties": {
    "type": { "const": "card-list" },
    "title": { "type": "string" },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "body": { "type": "string" },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "actionId"],
              "properties": {
                "label": { "type": "string" },
                "actionId": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
